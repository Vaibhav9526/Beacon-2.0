# Copy to .env for Docker Compose. Never commit real provider credentials.
ALLOW_DEMO_AUTH=false
PUBLIC_API_URL=http://localhost:8000

# Self-hosted Textbelt. Delivery requires a real SMTP account and test recipients.
TEXTBELT_SMTP_HOST=
TEXTBELT_SMTP_PORT=587
TEXTBELT_SMTP_USER=
TEXTBELT_SMTP_PASS=
TEXTBELT_SMTP_SECURE=false
TEXTBELT_FROM=BEACON <beacon@example.com>
TEXTBELT_REGION=intl
TEXTBELT_TEST_RECIPIENTS=

# Create the bot with Telegram @BotFather. The bot remains healthy but inactive
# when this is empty, so the rest of the BEACON stack can still run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION_TTL_SECONDS=2592000

# AI/fact-check gateway: Claude -> Gemini -> Groq -> deterministic local analysis.
# Keep the auth token only in an ignored .env or deployment secret store.
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_AUTH_TOKEN=replace-with-your-anthropic-auth-token
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# BHASHINI pipeline-compute configuration. Obtain these values from the
# BHASHINI pipeline config response; the auth header name is provider-issued.
BHASHINI_COMPUTE_URL=
BHASHINI_COMPUTE_AUTH_NAME=
BHASHINI_COMPUTE_AUTH_VALUE=
BHASHINI_NMT_SERVICE_ID=

# Optional exact fact-check matches. GDELT related-news source retrieval works
# without a key; this key adds Google Fact Check Explorer ClaimReview results.
GOOGLE_FACT_CHECK_API_KEY=
VERIFICATION_TIMEOUT_MS=5000
VERIFICATION_MAX_SOURCES=8

# All three are required for Cloudinary. Without them, evidence is retained
# in the durable beacon_uploads Docker volume instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=beacon/evidence

CLUSTER_DISTANCE_METERS=2500
CLUSTER_WINDOW_HOURS=2
CLUSTER_TEXT_SIMILARITY=0.38
UPLOAD_MAX_FILES=4
UPLOAD_MAX_FILE_BYTES=10000000

# Optional outbound adapters. Delivery is intentionally restricted to these
# comma-separated demo recipients; provider credentials alone never send.
FCM_SERVER_KEY=
FCM_TEST_TOKENS=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEST_RECIPIENTS=
MSG91_MESSAGE_VARIABLE=BEACON_MESSAGE
